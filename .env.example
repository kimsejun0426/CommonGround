# CommonGround server configuration template. Contains no credentials.
# Copy values into your local runtime's ignored .dev.vars OR .env file,
# or configure server-side bindings in your hosting environment.
# Verify the actual configuration through the authenticated app.
# Do not commit credential values or paste them into public demo materials.

# PayPal SANDBOX app credentials only. The backend has no live payment mode.
# PAYPAL_CLIENT_ID is the only PayPal credential allowed in public config.
# PAYPAL_CLIENT_SECRET stays server-side.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Empty key means rules_demo for proposals; free-text interpretation returns 503.
# Neither behavior fabricates a live AI response. Manual field editing remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Explicit local-development opt-in only. Leave false on hosted builds.
# The backend also requires a development build, NODE_ENV != production,
# and request hostname localhost or 127.0.0.1.
ALLOW_LOCAL_DEMO_AUTH=false

# DB is a Cloudflare D1 binding configured by the hosting manifest/runtime.
# It is not a database URL or credential to put in this template.
